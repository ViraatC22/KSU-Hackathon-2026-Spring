# Database (Prisma Postgres local, or Neon/Supabase URL)
DATABASE_URL="postgresql://user:pass@localhost:5432/ndalama"

# Anthropic Claude API (optional advisor integration)
ANTHROPIC_API_KEY="sk-ant-..."

# Auth (credentials sign-in is disabled unless explicitly enabled for local demos)
NEXTAUTH_SECRET="replace-with-a-random-32-byte-value"
NEXTAUTH_URL="http://localhost:3000"
ENABLE_DEMO_AUTH="false"
DEMO_OTP=""

# ML Service (Python FastAPI - only for OCR)
ML_SERVICE_URL="http://localhost:8000"
CORS_ORIGINS="http://localhost:3000"

# OCR upload limit, in bytes (defaults to 10 MiB)
MAX_DOCUMENT_BYTES="10485760"
